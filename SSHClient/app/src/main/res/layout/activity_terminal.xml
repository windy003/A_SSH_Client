<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1A1A1A"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Terminal output area — tap to bring up keyboard -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:fillViewport="true"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvOutput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textSize="13sp"
                android:textColor="#00FF41"
                android:background="@android:color/black"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:gravity="bottom"
                android:text="" />
        </ScrollView>

        <!-- Invisible keyboard input capture overlay -->
        <com.sshclient.ui.TerminalInputView
            android:id="@+id/terminalInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- Font size indicator (shown briefly when volume keys are pressed) -->
        <TextView
            android:id="@+id/tvFontSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="#CC000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Compact special-key toolbar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111111"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:paddingHorizontal="6dp">

            <Button style="@style/SpecialKey" android:id="@+id/btnEsc"    android:text="ESC" />
            <Button style="@style/SpecialKey" android:id="@+id/btnTab"    android:text="TAB" />
            <Button style="@style/SpecialKey" android:id="@+id/btnCtrlC"  android:text="^C"  />
            <Button style="@style/SpecialKey" android:id="@+id/btnCtrlD"  android:text="^D"  />
            <Button style="@style/SpecialKey" android:id="@+id/btnCtrlZ"  android:text="^Z"  />
            <Button style="@style/SpecialKey" android:id="@+id/btnUp"     android:text="▲"   />
            <Button style="@style/SpecialKey" android:id="@+id/btnDown"   android:text="▼"   />
            <Button style="@style/SpecialKey" android:id="@+id/btnLeft"   android:text="◀"   />
            <Button style="@style/SpecialKey" android:id="@+id/btnRight"  android:text="▶"   />
            <Button style="@style/SpecialKey" android:id="@+id/btnHome"   android:text="Home"/>
            <Button style="@style/SpecialKey" android:id="@+id/btnEnd"    android:text="End" />
            <Button style="@style/SpecialKey" android:id="@+id/btnPgUp"   android:text="PgUp"/>
            <Button style="@style/SpecialKey" android:id="@+id/btnPgDn"   android:text="PgDn"/>

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>

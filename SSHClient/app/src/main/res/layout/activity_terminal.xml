<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#F0F0F0"
            app:titleTextColor="#333333" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 终端输出区域 —— 点击唤出键盘 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            android:fillViewport="true"
            android:paddingVertical="8dp"
            android:paddingHorizontal="0dp">

            <HorizontalScrollView
                android:id="@+id/hScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none">

                <com.sshclient.ui.TerminalView
                    android:id="@+id/tvOutput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white" />
            </HorizontalScrollView>
        </ScrollView>

        <!-- 不可见的键盘输入捕获覆盖层 -->
        <com.sshclient.ui.TerminalInputView
            android:id="@+id/terminalInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- 字号指示器(按下音量键时短暂显示) -->
        <TextView
            android:id="@+id/tvFontSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="#CCFFFFFF"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="#333333"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:visibility="gone" />

    </FrameLayout>

    <!-- 紧凑型特殊按键工具栏 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEEEEE"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:paddingHorizontal="6dp">

            <Button style="@style/SpecialKey" android:id="@+id/btnEsc"    android:text="ESC" />
            <Button style="@style/SpecialKey" android:id="@+id/btnTab"    android:text="TAB" />
            <Button style="@style/SpecialKey" android:id="@+id/btnCtrlC"  android:text="^C"  />
            <Button style="@style/SpecialKey" android:id="@+id/btnCtrlD"  android:text="^D"  />
            <Button style="@style/SpecialKey" android:id="@+id/btnCtrlZ"  android:text="^Z"  />
            <Button style="@style/SpecialKey" android:id="@+id/btnUp"     android:text="▲"   />
            <Button style="@style/SpecialKey" android:id="@+id/btnDown"   android:text="▼"   />
            <Button style="@style/SpecialKey" android:id="@+id/btnLeft"   android:text="◀"   />
            <Button style="@style/SpecialKey" android:id="@+id/btnRight"  android:text="▶"   />
            <Button style="@style/SpecialKey" android:id="@+id/btnHome"   android:text="Home"/>
            <Button style="@style/SpecialKey" android:id="@+id/btnEnd"    android:text="End" />
            <Button style="@style/SpecialKey" android:id="@+id/btnPgUp"   android:text="PgUp"/>
            <Button style="@style/SpecialKey" android:id="@+id/btnPgDn"   android:text="PgDn"/>

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
